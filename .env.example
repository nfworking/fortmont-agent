# Comma-separated Fortmont WS gateway URLs. The agent probes all of them
# at startup and selects the lowest-latency reachable node.
FORTMONT_WS_NODES=wss://agents-1.fortmont.me/ws,wss://agents-2.fortmont.me/ws

# Optional: only needed for first-time enrollment. Prefer --token on the CLI
# so the enrollment token is not persisted in the environment longer than needed.
FORTMONT_ENROLLMENT_TOKEN=

# Runtime configuration
FORTMONT_CONFIG_DIR=./data
FORTMONT_VERSION=0.1.0
FORTMONT_CONNECT_TIMEOUT_SEC=10
FORTMONT_RECONNECT_MAX_SEC=30
FORTMONT_HEARTBEAT_SEC=30
FORTMONT_PING_INTERVAL_SEC=30
FORTMONT_LOG_LEVEL=info
